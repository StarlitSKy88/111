{
  "name": "opcone",
  "version": "1.0.0.0",
  "description": "OPC适配自测 + AI分析演示 - Hackathon项目",
  "main": "app.js",
  "scripts": {
    "start": "bash start.sh",
    "api": "node api/analyze.js",
    "proxy": "node proxy.js",
    "server": "npx http-server . -p 3000 -c-1 --cors",
    "test": "npm run test:js && npm run test:py",
    "test:js": "npm run test:auth && npm run test:ds && npm run test:api",
    "test:auth": "npx jest --no-coverage tests/auth.test.js",
    "test:ds": "npx jest --no-coverage tests/data-store.test.js",
    "test:api": "npx jest --no-coverage tests/api.test.js",
    "test:py": "python3 -m pytest tests/test_scripts.py -v",
    "test:watch": "npx jest --watch tests/auth.test.js",
    "coverage": "npx jest --coverage && python3 -m pytest tests/test_scripts.py --cov=. --cov-report=term"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarlitSKy88/111.git"
  },
  "keywords": [
    "opc",
    "ai",
    "hackathon"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.3",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
