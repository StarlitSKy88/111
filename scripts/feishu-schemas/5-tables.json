{
  "version": "1.0.0",
  "created": "2026-06-04",
  "purpose": "ONE-MCN L6 层飞书多维表格 schema 定义",
  "app_token_strategy": "single_app_token_for_all_5_tables",
  "tables": {
    "01_selection_library": {
      "name": "01·选题库",
      "description": "a1-scan + a3-reverse 输出，存放所有候选选题",
      "fields": [
        { "name": "选题标题", "type": "text", "required": true },
        { "name": "来源 URL", "type": "url", "required": false },
        { "name": "爆款公式", "type": "select", "options": ["A 反常识", "B 真实案例", "C 反差", "D 副业第 1 步", "E 反 AI 渣"] },
        { "name": "人设", "type": "select", "options": ["阿泽", "燃木", "中性"] },
        { "name": "状态", "type": "select", "options": ["候选", "已选", "脚本中", "已发布", "放弃"] },
        { "name": "爆款指数", "type": "number", "min": 0, "max": 100 },
        { "name": "原始数据", "type": "text" },
        { "name": "录入时间", "type": "datetime" }
      ]
    },
    "02_content_schedule": {
      "name": "02·内容排期",
      "description": "b1-publish 调度，按平台 × 时间排期",
      "fields": [
        { "name": "节点 ID", "type": "text" },
        { "name": "平台", "type": "select", "options": ["视频号", "抖音", "小红书", "B站"] },
        { "name": "发布时间", "type": "datetime", "required": true },
        { "name": "草稿链接", "type": "url" },
        { "name": "封面链接", "type": "url" },
        { "name": "状态", "type": "select", "options": ["待发", "已发", "失败", "已删"] },
        { "name": "视频 ID", "type": "text" },
        { "name": "D+1 数据", "type": "text" }
      ]
    },
    "03_fan_management": {
      "name": "03·粉丝管理",
      "description": "c1+c2+c3 输出，私域用户标签分层",
      "fields": [
        { "name": "微信号", "type": "text", "required": true },
        { "name": "标签", "type": "multi_select", "options": ["新粉", "活跃", "付费", "已转化", "已流失", "KOL"] },
        { "name": "来源节点", "type": "text" },
        { "name": "首次接触", "type": "datetime" },
        { "name": "LTV", "type": "currency", "symbol": "¥" },
        { "name": "最近互动", "type": "datetime" },
        { "name": "备注", "type": "text" }
      ]
    },
    "04_sales_pipeline": {
      "name": "04·销售管道",
      "description": "L5 变现层，从 lead 到成单全链路",
      "fields": [
        { "name": "Lead ID", "type": "text", "required": true },
        { "name": "来源节点", "type": "text" },
        { "name": "产品", "type": "select", "options": ["¥0 免费", "¥199 基础", "¥999 进阶", "¥3999 1v1", "¥4999 合伙人"] },
        { "name": "金额", "type": "currency", "symbol": "¥" },
        { "name": "状态", "type": "select", "options": ["咨询", "加微", "已发资料", "试听", "已付", "退款"] },
        { "name": "跟进人", "type": "select", "options": ["蕾姆", "昴君", "AI 客服"] },
        { "name": "首触时间", "type": "datetime" },
        { "name": "成单时间", "type": "datetime" }
      ]
    },
    "05_finance": {
      "name": "05·财务收支",
      "description": "L5 + L6 收入支出流水",
      "fields": [
        { "name": "日期", "type": "date", "required": true },
        { "name": "类型", "type": "select", "options": ["收入", "支出"] },
        { "name": "金额", "type": "currency", "symbol": "¥" },
        { "name": "类目", "type": "select", "options": ["课程销售", "咨询收入", "API 费用", "VPS 费用", "工具订阅", "内容外包", "其他"] },
        { "name": "来源/去向", "type": "text" },
        { "name": "关联订单", "type": "text" }
      ]
    }
  },
  "g0_checklist_top": [
    { "day": 3, "check": "视频发布数 ≥ 2 条", "threshold": "<2 停止写文档 72h 专注制作" },
    { "day": 5, "check": "单条最高播放量 ≥ 500", "threshold": "<500 调整选题重写脚本" },
    { "day": 7, "check": "加微信数 ≥ 10", "threshold": "<10 检查 CTA + 评论区引导" }
  ]
}
