# ONE-MCN Environment Variables (v5.1.1)
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql://postgres:dev123@localhost:5432/one_mcn_test
DATABASE_TEST_URL=postgresql://postgres:dev123@localhost:5432/test_restore

# Server
PORT=3000
NODE_ENV=development

# Stripe (M1 Day 2 启用)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_TIER1=price_xxx
STRIPE_PRICE_TIER2=price_xxx

# 微信支付 (M1 Day 3 启用)
WECHAT_PAY_MCH_ID=xxx
WECHAT_PAY_API_KEY=xxx

# 支付宝 (M1 Day 3 启用)
ALIPAY_APP_ID=xxx
ALIPAY_PRIVATE_KEY=xxx

# 飞书 push (M1 Day 5 启用)
FEISHU_WEBHOOK=https://open.feishu.cn/xxx

# AI 模型
MINIMAX_API_KEY=xxx
DEEPSEEK_API_KEY=xxx

# JWT
JWT_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-in-prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d