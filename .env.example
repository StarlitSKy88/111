# ONE-MCN Environment Variables (v5.4.3)
# Copy to .env and fill in real values
# 任何 .env 文件不要提交 git

# === Database ===
DATABASE_URL=postgres://opc-1@localhost:5432/one_mcn_test
DATABASE_TEST_URL=postgres://opc-1@localhost:5432/test_restore

# === Server ===
PORT=3000
NODE_ENV=development

# === LLM — Anthropic Claude（用户已提供 relay）===
ANTHROPIC_BASE_URL=https://relay.bytenote.net
ANTHROPIC_AUTH_TOKEN=cr_xxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === LLM — OpenAI（备选）===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo-preview
# LLM_PROVIDER=openai

# === Email (腾讯云 SMTP) ===
QCLOUD_MAIL_USER=nodemailer@taomyst.top
QCLOUD_MAIL_PASS=xxxxxxxxxxxx
QCLOUD_MAIL_FROM=nodemailer@taomyst.top

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === 微信支付 (v3) ===
WECHAT_PAY_MCH_ID=xxx
WECHAT_PAY_API_KEY=xxx
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/webhooks/wechat

# === 支付宝 ===
